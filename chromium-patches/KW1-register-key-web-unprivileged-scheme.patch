diff --git a/components/webapps/key_web/key_web_origin.cc b/components/webapps/key_web/key_web_origin.cc
new file mode 100644
--- /dev/null
+++ b/components/webapps/key_web/key_web_origin.cc
@@ -0,0 +1,127 @@
+// Copyright 2026 The Key-Origin Web Authors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "components/webapps/key_web/key_web_origin.h"
+
+#include <string>
+#include <string_view>
+
+#include "base/base64.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_util.h"
+#include "base/types/expected.h"
+#include "base/types/expected_macros.h"
+#include "components/web_package/signed_web_bundles/signed_web_bundle_id.h"
+#include "components/webapps/key_web/scheme.h"
+#include "crypto/hash.h"
+
+namespace key_web {
+
+namespace {
+
+constexpr char kPartitionHashContext[] = "key-web-partition/v1";
+constexpr size_t kKeyHostSuffixLength = sizeof(kKeyHostSuffix) - 1;
+
+base::expected<web_package::SignedWebBundleId, std::string> ParseKwId(
+    std::string_view id) {
+  ASSIGN_OR_RETURN(auto web_bundle_id,
+                   web_package::SignedWebBundleId::Create(id));
+  switch (web_bundle_id.type()) {
+    case web_package::SignedWebBundleId::Type::kEd25519PublicKey:
+    case web_package::SignedWebBundleId::Type::kEcdsaP256PublicKey:
+      return web_bundle_id;
+    case web_package::SignedWebBundleId::Type::kProxyMode:
+      return base::unexpected(
+          "Proxy-mode (development) IDs are never valid key-web IDs.");
+  }
+}
+
+}  // namespace
+
+KeyWebOrigin::KeyWebOrigin(const web_package::SignedWebBundleId& web_bundle_id)
+    : origin_(url::Origin::CreateFromNormalizedTuple(
+          kKeyWebScheme,
+          base::StrCat({web_bundle_id.id(), kKeyHostSuffix}),
+          /*port=*/0)),
+      web_bundle_id_(web_bundle_id) {
+  CHECK(!web_bundle_id.is_for_proxy_mode());
+}
+
+KeyWebOrigin::KeyWebOrigin(const KeyWebOrigin&) = default;
+KeyWebOrigin& KeyWebOrigin::operator=(const KeyWebOrigin&) = default;
+KeyWebOrigin::~KeyWebOrigin() = default;
+
+// static
+base::expected<KeyWebOrigin, std::string> KeyWebOrigin::Create(
+    const GURL& url) {
+  if (!url.is_valid()) {
+    return base::unexpected("Invalid URL");
+  }
+  if (!url.SchemeIs(kKeyWebScheme)) {
+    return base::unexpected(base::StrCat(
+        {"The URL scheme must be ", kKeyWebScheme, ", but was ",
+         url.GetScheme()}));
+  }
+  // `key-web` is registered as url::SCHEME_WITH_HOST, so a canonical GURL can
+  // never carry these. Re-check anyway: an origin must be (scheme, host, 0).
+  if (url.has_username() || url.has_password() || url.has_port()) {
+    return base::unexpected("key-web URLs must not carry userinfo or a port.");
+  }
+  return CreateFromHost(url.GetHost());
+}
+
+// static
+base::expected<KeyWebOrigin, std::string> KeyWebOrigin::CreateFromHost(
+    std::string_view host) {
+  if (!IsKeyHost(host)) {
+    return base::unexpected(base::StrCat(
+        {"The host of a key-web origin must be <kw-id>.key (got ", host,
+         "). Name hosts are resolved and redirected, never committed."}));
+  }
+  std::string_view id = host.substr(0, host.size() - kKeyHostSuffixLength);
+  return ParseKwId(id).transform(
+      [](const web_package::SignedWebBundleId& web_bundle_id) {
+        return KeyWebOrigin(web_bundle_id);
+      });
+}
+
+// static
+std::optional<std::string> KeyWebOrigin::CanonicalHostForBareId(
+    std::string_view host) {
+  if (host.find('.') != std::string_view::npos) {
+    return std::nullopt;
+  }
+  if (!ParseKwId(host).has_value()) {
+    return std::nullopt;
+  }
+  return base::StrCat({host, kKeyHostSuffix});
+}
+
+GURL KeyWebOrigin::GetUrl() const {
+  return origin_.GetURL();
+}
+
+std::string KeyWebOrigin::GetPartitionDomain() const {
+  return "k" + base::Base64Encode(crypto::hash::Sha256(
+                   base::StrCat({kPartitionHashContext, origin_.Serialize()})));
+}
+
+bool IsKeyHost(std::string_view host) {
+  if (!base::EndsWith(host, kKeyHostSuffix)) {
+    return false;
+  }
+  std::string_view id = host.substr(0, host.size() - kKeyHostSuffixLength);
+  // Exactly one label before ".key": 56 (Ed25519) or 58 (P-256) characters of
+  // the lowercase RFC 4648 base32 alphabet.
+  if (id.size() != 56 && id.size() != 58) {
+    return false;
+  }
+  for (char c : id) {
+    if (!((c >= 'a' && c <= 'z') || (c >= '2' && c <= '7'))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace key_web
diff --git a/components/webapps/key_web/key_web_origin.h b/components/webapps/key_web/key_web_origin.h
new file mode 100644
--- /dev/null
+++ b/components/webapps/key_web/key_web_origin.h
@@ -0,0 +1,70 @@
+// Copyright 2026 The Key-Origin Web Authors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#ifndef COMPONENTS_WEBAPPS_KEY_WEB_KEY_WEB_ORIGIN_H_
+#define COMPONENTS_WEBAPPS_KEY_WEB_KEY_WEB_ORIGIN_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/types/expected.h"
+#include "components/web_package/signed_web_bundles/signed_web_bundle_id.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace key_web {
+
+// The origin of an unprivileged key-web app: key-web://<kw-id>.key
+//
+// Mirrors web_app::IwaOrigin, with three deliberate differences:
+//   * the host is `<kw-id>.key`, never the bare ID, so a human-readable name
+//     host (`cool-site.alice.example`) can never be parsed into an origin;
+//   * proxy-mode (development) IDs are rejected;
+//   * the storage partition domain uses the "k" prefix and its own hash
+//     context, so it can never collide with an IWA partition.
+class KeyWebOrigin {
+ public:
+  explicit KeyWebOrigin(const web_package::SignedWebBundleId& web_bundle_id);
+
+  // Parses a canonical key URL. Rejects non-key-web schemes, ports,
+  // userinfo, name hosts, bare IDs, and proxy-mode IDs.
+  static base::expected<KeyWebOrigin, std::string> Create(const GURL& url);
+
+  // Parses a host of the form `<kw-id>.key`.
+  static base::expected<KeyWebOrigin, std::string> CreateFromHost(
+      std::string_view host);
+
+  // If `host` is a bare kw-id (typed input such as key-web://<kw-id>/), returns
+  // the canonical `<kw-id>.key` host. Returns nullopt for everything else.
+  static std::optional<std::string> CanonicalHostForBareId(
+      std::string_view host);
+
+  KeyWebOrigin(const KeyWebOrigin&);
+  KeyWebOrigin& operator=(const KeyWebOrigin&);
+  ~KeyWebOrigin();
+
+  const url::Origin& origin() const { return origin_; }
+  const web_package::SignedWebBundleId& web_bundle_id() const {
+    return web_bundle_id_;
+  }
+
+  // key-web://<kw-id>.key/
+  GURL GetUrl() const;
+
+  // "k" + Base64(SHA-256("key-web-partition/v1" + origin.Serialize())).
+  std::string GetPartitionDomain() const;
+
+  auto operator<=>(const KeyWebOrigin&) const = default;
+
+ private:
+  url::Origin origin_;
+  web_package::SignedWebBundleId web_bundle_id_;
+};
+
+// True for `<kw-id>.key` hosts and for nothing else. Never parses names.
+bool IsKeyHost(std::string_view host);
+
+}  // namespace key_web
+
+#endif  // COMPONENTS_WEBAPPS_KEY_WEB_KEY_WEB_ORIGIN_H_
diff --git a/components/webapps/key_web/key_web_origin_unittest.cc b/components/webapps/key_web/key_web_origin_unittest.cc
new file mode 100644
--- /dev/null
+++ b/components/webapps/key_web/key_web_origin_unittest.cc
@@ -0,0 +1,93 @@
+// Copyright 2026 The Key-Origin Web Authors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "components/webapps/key_web/key_web_origin.h"
+
+#include "components/web_package/signed_web_bundles/signed_web_bundle_id.h"
+#include "components/webapps/key_web/scheme.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace key_web {
+namespace {
+
+// Worked example from the architecture spec (§1.2). Not a real key: the
+// payload is SHA-256 of a fixed public string, with the Ed25519 suffix.
+constexpr char kKEdId[] =
+    "mix2p32okr3zpmwz3pily6bmbjlfrjvpyzljdkc4mzvpkb6lf2mqaaic";
+
+GURL KeyUrl(std::string_view tail = "/") {
+  return GURL(std::string("key-web://") + kKEdId + ".key" + std::string(tail));
+}
+
+TEST(KeyWebOriginTest, ParsesKEd) {
+  auto origin = KeyWebOrigin::Create(KeyUrl("/index.html"));
+  ASSERT_TRUE(origin.has_value()) << origin.error();
+  EXPECT_EQ(origin->web_bundle_id().type(),
+            web_package::SignedWebBundleId::Type::kEd25519PublicKey);
+  EXPECT_EQ(origin->origin().Serialize(),
+            std::string("key-web://") + kKEdId + ".key");
+  EXPECT_EQ(origin->GetUrl(), KeyUrl());
+}
+
+TEST(KeyWebOriginTest, IsTupleOriginNotOpaque) {
+  auto origin = KeyWebOrigin::Create(KeyUrl());
+  ASSERT_TRUE(origin.has_value());
+  EXPECT_FALSE(origin->origin().opaque());
+  EXPECT_EQ(origin->origin().scheme(), kKeyWebScheme);
+}
+
+TEST(KeyWebOriginTest, RejectsNameHost) {
+  EXPECT_FALSE(
+      KeyWebOrigin::Create(GURL("key-web://cool-site.alice.example/")).has_value());
+  EXPECT_FALSE(
+      KeyWebOrigin::Create(GURL("key-web://cool-site.alice.dht/")).has_value());
+  EXPECT_FALSE(KeyWebOrigin::Create(GURL("key-web://notes.mom.local/")).has_value());
+}
+
+TEST(KeyWebOriginTest, RequiresDotKeySuffix) {
+  // A bare ID is typed input only; it is rewritten, never an origin.
+  EXPECT_FALSE(KeyWebOrigin::Create(GURL(std::string("key-web://") + kKEdId + "/"))
+                   .has_value());
+  EXPECT_EQ(KeyWebOrigin::CanonicalHostForBareId(kKEdId),
+            std::string(kKEdId) + ".key");
+  EXPECT_FALSE(KeyWebOrigin::CanonicalHostForBareId("cool-site.alice.example"));
+}
+
+TEST(KeyWebOriginTest, RejectsOtherSchemes) {
+  EXPECT_FALSE(KeyWebOrigin::Create(GURL(std::string("isolated-app://") +
+                                         kKEdId + "/"))
+                   .has_value());
+  EXPECT_FALSE(
+      KeyWebOrigin::Create(GURL(std::string("https://") + kKEdId + ".key/"))
+          .has_value());
+}
+
+TEST(KeyWebOriginTest, RejectsProxyMode) {
+  auto proxy_id = web_package::SignedWebBundleId::CreateRandomForProxyMode();
+  EXPECT_FALSE(
+      KeyWebOrigin::CreateFromHost(proxy_id.id() + ".key").has_value());
+}
+
+TEST(KeyWebOriginTest, LowercasesHost) {
+  std::string upper = std::string("key-web://") + kKEdId + ".KEY/";
+  for (char& c : upper) {
+    c = static_cast<char>(toupper(c));
+  }
+  auto origin = KeyWebOrigin::Create(GURL(upper));
+  ASSERT_TRUE(origin.has_value()) << origin.error();
+  EXPECT_EQ(origin->origin().host(), std::string(kKEdId) + ".key");
+}
+
+TEST(KeyWebOriginTest, PartitionDomainIsKeyScoped) {
+  auto origin = KeyWebOrigin::Create(KeyUrl());
+  ASSERT_TRUE(origin.has_value());
+  const std::string domain = origin->GetPartitionDomain();
+  ASSERT_FALSE(domain.empty());
+  EXPECT_EQ(domain[0], 'k');
+  // Stable across paths of the same origin.
+  EXPECT_EQ(domain, KeyWebOrigin::Create(KeyUrl("/a/b?c"))->GetPartitionDomain());
+}
+
+}  // namespace
+}  // namespace key_web
