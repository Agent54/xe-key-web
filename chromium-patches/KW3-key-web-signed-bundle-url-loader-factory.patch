@@ -0,0 +1,48 @@
+// Copyright 2026 The Key-Origin Web Authors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#ifndef COMPONENTS_WEBAPPS_KEY_WEB_URL_LOADING_KEY_WEB_URL_LOADER_FACTORY_H_
+#define COMPONENTS_WEBAPPS_KEY_WEB_URL_LOADING_KEY_WEB_URL_LOADER_FACTORY_H_
+
+#include <optional>
+
+#include "content/public/browser/frame_tree_node_id.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "services/network/public/mojom/url_loader_factory.mojom-forward.h"
+#include "url/origin.h"
+
+namespace content {
+class BrowserContext;
+}  // namespace content
+
+namespace key_web {
+
+// A non-network URLLoaderFactory for key-web://<kw-id>.key/.
+//
+// Every response is read from a verified Signed Web Bundle (see
+// KeyWebReaderCache); nothing ever falls back to the network. Before a
+// response reaches the renderer, app-supplied dangerous headers are stripped
+// and the Tier 0 policy (exfiltration-proof CSP, Connection-Allowlist,
+// COOP/COEP/CORP, Permissions-Policy, X-DNS-Prefetch-Control: off) is
+// injected, then the headers are re-parsed by the network service so
+// navigations and workers enforce exactly what was injected.
+//
+// Only GET and HEAD are served. Name hosts and bare IDs fail with
+// ERR_INVALID_URL (bare IDs are rewritten to `<kw-id>.key` by the embedder's
+// BrowserURLHandler before navigation). Unlike the Isolated Web App factory,
+// there is no install lookup, allowlist, or dev-mode proxy: the key is the
+// only authority.
+class KeyWebURLLoaderFactory {
+ public:
+  // `app_origin`, when set, restricts the factory to that one key-web origin
+  // (subresources, dedicated/shared workers): a compromised renderer cannot
+  // read another key's bundle through it.
+  static mojo::PendingRemote<network::mojom::URLLoaderFactory> Create(
+      content::BrowserContext* browser_context,
+      std::optional<url::Origin> app_origin,
+      std::optional<content::FrameTreeNodeId> frame_tree_node_id);
+};
+
+}  // namespace key_web
+
+#endif  // COMPONENTS_WEBAPPS_KEY_WEB_URL_LOADING_KEY_WEB_URL_LOADER_FACTORY_H_
diff --git a/components/webapps/key_web/url_loading/key_web_url_loading_unittest.cc b/components/webapps/key_web/url_loading/key_web_url_loading_unittest.cc
