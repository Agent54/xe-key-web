+// Copyright 2026 The Key-Origin Web Authors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#ifndef COMPONENTS_WEBAPPS_KEY_WEB_URL_LOADING_KEY_WEB_READER_CACHE_H_
+#define COMPONENTS_WEBAPPS_KEY_WEB_URL_LOADING_KEY_WEB_READER_CACHE_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/supports_user_data.h"
+#include "base/types/expected.h"
+#include "components/webapps/isolated_web_apps/reading/signed_web_bundle_reader.h"
+#include "components/webapps/key_web/key_web_origin.h"
+
+namespace content {
+class BrowserContext;
+}  // namespace content
+
+namespace key_web {
+
+// Per-profile cache of SignedWebBundleReaders for key-web releases.
+//
+// Zero install ceremony: a release for key-web://<kw-id>.key/ is simply the
+// file `<profile>/Key Web Bundles/<kw-id>.swbn`, put there by a resolver, a
+// download or the user. Nothing is registered and no prompt is shown, because
+// nothing is trusted: every file is verified before a single byte is served.
+//
+// Verification reuses Chromium's own Signed Web Bundle stack:
+//   * web_app::SignedWebBundleReader::Create(..., verify_signatures=true)
+//     parses the integrity block out of process and verifies every signature
+//     over SHA-512 of the unsigned bundle (SignedWebBundleSignatureVerifier);
+//   * web_package::SignedWebBundleIntegrityBlock is then checked by
+//     ValidateKeyWebIntegrityBlock() (ID match, self-certifying key, keyWeb);
+//   * every entry in the bundle index must be same-origin with the key URL.
+// No IWA trust (allowlists, key distribution, dev mode) is ever consulted.
+//
+// A reader is reused until the file's size or modification time changes.
+// Monotonic release ordering (HWM / rollback protection) is out of scope for
+// this prototype and belongs to the ReleaseStore (Spec §1.6).
+class KeyWebReaderCache : public base::SupportsUserData::Data {
+ public:
+  using ReaderOrError =
+      base::expected<base::WeakPtr<web_app::SignedWebBundleReader>,
+                     std::string>;
+  using ReaderCallback = base::OnceCallback<void(ReaderOrError)>;
+
+  static KeyWebReaderCache& GetOrCreate(content::BrowserContext* context);
+
+  // `<profile>/Key Web Bundles`.
+  static base::FilePath GetBundleDirectory(content::BrowserContext* context);
+
+  explicit KeyWebReaderCache(base::FilePath bundle_directory);
+  KeyWebReaderCache(const KeyWebReaderCache&) = delete;
+  KeyWebReaderCache& operator=(const KeyWebReaderCache&) = delete;
+  ~KeyWebReaderCache() override;
+
+  void GetVerifiedReader(const KeyWebOrigin& origin, ReaderCallback callback);
+
+  // Invalidated when the BrowserContext (which owns the cache) goes away.
+  base::WeakPtr<KeyWebReaderCache> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+ private:
+  struct Entry {
+    Entry();
+    Entry(Entry&&);
+    Entry& operator=(Entry&&);
+    ~Entry();
+
+    base::File::Info file_info;
+    uint64_t generation = 0;
+    std::unique_ptr<web_app::SignedWebBundleReader> reader;
+    std::vector<ReaderCallback> pending;
+  };
+
+  void OnFileInfo(const KeyWebOrigin& origin,
+                  const base::FilePath& path,
+                  ReaderCallback callback,
+                  std::optional<base::File::Info> info);
+  void OnReaderCreated(const KeyWebOrigin& origin,
+                       uint64_t generation,
+                       web_app::SignedWebBundleReader::Result result);
+  void Resolve(const std::string& id, const ReaderOrError& result);
+
+  const base::FilePath bundle_directory_;
+  std::map<std::string, Entry> entries_;
+  uint64_t next_generation_ = 0;
+  base::WeakPtrFactory<KeyWebReaderCache> weak_factory_{this};
+};
+
+}  // namespace key_web
+
+#endif  // COMPONENTS_WEBAPPS_KEY_WEB_URL_LOADING_KEY_WEB_READER_CACHE_H_
