+#ifndef COMPONENTS_WEBAPPS_KEY_WEB_URL_LOADING_KEY_WEB_URL_REWRITE_H_
+#define COMPONENTS_WEBAPPS_KEY_WEB_URL_LOADING_KEY_WEB_URL_REWRITE_H_
+
+class GURL;
+
+namespace content {
+class BrowserContext;
+}  // namespace content
+
+namespace key_web {
+
+// content::BrowserURLHandler::URLHandler. Rewrites typed / linked input of the
+// form key-web://<ed25519-or-p256-kw-id>/<path> to the single canonical origin
+// key-web://<kw-id>.key/<path> (Spec §1.3 rule 4), so one key never maps to
+// two origins. Returns false (and leaves `url` untouched) for everything
+// else, including name hosts.
+bool RewriteBareKeyWebUrl(GURL* url, content::BrowserContext* context);
+
+}  // namespace key_web
