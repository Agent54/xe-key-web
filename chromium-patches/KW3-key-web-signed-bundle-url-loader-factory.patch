+
+#include "components/webapps/key_web/url_loading/key_web_url_rewrite.h"
+
+#include <optional>
+#include <string>
+
+#include "components/webapps/key_web/key_web_origin.h"
+#include "components/webapps/key_web/scheme.h"
+#include "url/gurl.h"
+
+namespace key_web {
+
+bool RewriteBareKeyWebUrl(GURL* url, content::BrowserContext* context) {
+  if (!url || !url->is_valid() || !url->SchemeIs(kKeyWebScheme)) {
+    return false;
+  }
+  std::optional<std::string> host =
+      KeyWebOrigin::CanonicalHostForBareId(url->GetHost());
+  if (!host) {
+    return false;
+  }
+  GURL::Replacements replacements;
+  replacements.SetHostStr(*host);
+  *url = url->ReplaceComponents(replacements);
+  return true;
+}
+
+}  // namespace key_web
