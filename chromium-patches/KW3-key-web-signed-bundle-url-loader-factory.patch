+}
diff --git a/components/webapps/key_web/url_loading/key_web_bundle_validation.cc b/components/webapps/key_web/url_loading/key_web_bundle_validation.cc
new file mode 100644
--- /dev/null
+++ b/components/webapps/key_web/url_loading/key_web_bundle_validation.cc
@@ -0,0 +1,103 @@
+// Copyright 2026 The Key-Origin Web Authors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "components/webapps/key_web/url_loading/key_web_bundle_validation.h"
+
+#include <optional>
+#include <string>
+#include <variant>
+
+#include "base/strings/strcat.h"
+#include "components/cbor/reader.h"
+#include "components/cbor/values.h"
+#include "components/web_package/signed_web_bundles/signed_web_bundle_id.h"
+#include "components/web_package/signed_web_bundles/signed_web_bundle_integrity_block.h"
+#include "components/web_package/signed_web_bundles/types.h"
+#include "components/webapps/key_web/key_web_origin.h"
+
+namespace key_web {
+
+namespace {
+
+// attributes { "keyWeb": { "v": 1, "seq": n, ... } } is at most 2 levels deep
+// before the (optional) KEL; KEL events add a few more.
+constexpr size_t kMaxAttributesNesting = 8;
+constexpr uint64_t kSupportedKeyWebVersion = 1;
+
+std::optional<uint64_t> GetUnsigned(const cbor::Value::MapValue& map,
+                                    const char* key) {
+  auto it = map.find(cbor::Value(key));
+  if (it == map.end() || !it->second.is_unsigned()) {
+    return std::nullopt;
+  }
+  return static_cast<uint64_t>(it->second.GetUnsigned());
+}
+
+}  // namespace
+
+base::expected<KeyWebAttribute, std::string> ParseKeyWebAttribute(
+    base::span<const uint8_t> attributes_cbor) {
+  cbor::Reader::Config config;
+  config.max_nesting_level = kMaxAttributesNesting;
+  std::optional<cbor::Value> attributes =
+      cbor::Reader::Read(attributes_cbor, config);
+  if (!attributes || !attributes->is_map()) {
+    return base::unexpected("Integrity block attributes are not a CBOR map.");
+  }
+  const cbor::Value::MapValue& map = attributes->GetMap();
+  auto key_web = map.find(cbor::Value("keyWeb"));
+  if (key_web == map.end()) {
+    return base::unexpected(
+        "The bundle has no `keyWeb` integrity-block attribute, so its author "
+        "never targeted key-web://. Refusing to load it.");
+  }
+  if (!key_web->second.is_map()) {
+    return base::unexpected("`keyWeb` must be a CBOR map.");
+  }
+  const cbor::Value::MapValue& kw = key_web->second.GetMap();
+  std::optional<uint64_t> version = GetUnsigned(kw, "v");
+  std::optional<uint64_t> seq = GetUnsigned(kw, "seq");
+  if (!version || *version != kSupportedKeyWebVersion) {
+    return base::unexpected("`keyWeb.v` must be 1.");
+  }
+  if (!seq) {
+    return base::unexpected("`keyWeb.seq` must be an unsigned integer.");
+  }
+  return KeyWebAttribute{.version = *version, .seq = *seq};
+}
+
+base::expected<KeyWebAttribute, std::string> ValidateKeyWebIntegrityBlock(
+    const web_package::SignedWebBundleIntegrityBlock& integrity_block,
+    const KeyWebOrigin& origin) {
+  const web_package::SignedWebBundleId& expected = origin.web_bundle_id();
+  if (integrity_block.web_bundle_id() != expected) {
+    return base::unexpected(base::StrCat(
+        {"webBundleId ", integrity_block.web_bundle_id().id(),
+         " does not match the key-web origin ", expected.id()}));
+  }
+
+  bool self_certified = false;
+  for (const web_package::PublicKey& key :
+       integrity_block.signature_stack().public_keys()) {
+    const web_package::SignedWebBundleId derived = std::visit(
+        [](const auto& public_key) {
+          return web_package::SignedWebBundleId::CreateForPublicKey(
+              public_key);
+        },
+        key);
+    if (derived == expected) {
+      self_certified = true;
+      break;
+    }
+  }
+  if (!self_certified) {
+    return base::unexpected(
+        "No verified signature's public key derives to the key-web ID. "
+        "key-web identity is self-certifying; rotation data is never "
+        "consulted.");
+  }
+
+  return ParseKeyWebAttribute(integrity_block.attributes_cbor());
+}
+
+}  // namespace key_web
