+
+namespace {
+
+void LogToConsole(std::optional<content::FrameTreeNodeId> frame_tree_node_id,
+                  const std::string& message) {
+  if (!frame_tree_node_id) {
+    return;
+  }
+  content::WebContents* web_contents =
+      content::WebContents::FromFrameTreeNodeId(*frame_tree_node_id);
+  if (!web_contents) {
+    return;
+  }
+  web_contents->GetPrimaryMainFrame()->AddMessageToConsole(
+      blink::mojom::ConsoleMessageLevel::kError, message);
+}
+
+// Serves one request from a verified bundle. Self-owned by its receiver.
+class KeyWebURLLoader : public network::mojom::URLLoader {
+ public:
+  KeyWebURLLoader(base::WeakPtr<KeyWebReaderCache> cache,
+                  KeyWebOrigin origin,
+                  mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+                  const network::ResourceRequest& request,
+                  std::optional<content::FrameTreeNodeId> frame_tree_node_id)
+      : cache_(std::move(cache)),
+        origin_(std::move(origin)),
+        client_(std::move(client)),
+        request_(request),
+        frame_tree_node_id_(frame_tree_node_id) {}
+
+  KeyWebURLLoader(const KeyWebURLLoader&) = delete;
+  KeyWebURLLoader& operator=(const KeyWebURLLoader&) = delete;
+  ~KeyWebURLLoader() override = default;
+
+  void Start() {
+    if (!cache_) {
+      Fail(net::ERR_FAILED, "key-web: profile is shutting down.");
+      return;
+    }
+    cache_->GetVerifiedReader(origin_,
+                              base::BindOnce(&KeyWebURLLoader::OnReader,
+                                             weak_factory_.GetWeakPtr()));
+  }
+
+ private:
+  void OnReader(KeyWebReaderCache::ReaderOrError reader) {
+    if (!client_.is_connected()) {
+      return;
+    }
+    if (!reader.has_value() || !reader.value()) {
+      // Never fall back to the network: an unverifiable release is simply
+      // unavailable.
+      Fail(net::ERR_INVALID_WEB_BUNDLE,
+           reader.has_value() ? "key-web: reader went away." : reader.error());
+      return;
+    }
+    reader_ = reader.value();
+    reader_->ReadResponse(request_,
+                          base::BindOnce(&KeyWebURLLoader::OnResponseRead,
+                                         weak_factory_.GetWeakPtr()));
+  }
+
+  void OnResponseRead(
+      base::expected<web_package::mojom::BundleResponsePtr,
+                     web_app::SignedWebBundleReader::ReadResponseError>
+          response) {
+    if (!client_.is_connected()) {
+      return;
+    }
+    if (!response.has_value()) {
+      if (response.error().type == web_app::SignedWebBundleReader::
+                                       ReadResponseError::Type::
+                                           kResponseNotFound) {
+        RespondGenerated(net::HTTP_NOT_FOUND);
+        return;
+      }
+      Fail(net::ERR_INVALID_WEB_BUNDLE, response.error().message);
+      return;
+    }
+    if (response.value()->response_code != net::HTTP_OK) {
+      Fail(net::ERR_INVALID_WEB_BUNDLE,
+           "key-web: bundle responses must have status 200.");
+      return;
+    }
+
+    network::mojom::URLResponseHeadPtr head =
+        web_package::CreateResourceResponseFromHeaderString(
+            web_package::CreateHeaderString(response.value()));
+    head->content_length =
+        static_cast<int64_t>(response.value()->payload_length);
+    ParseAndRespond(std::move(head), std::move(response.value()));
+  }
+
+  void RespondGenerated(net::HttpStatusCode status) {
+    network::mojom::URLResponseHeadPtr head =
+        web_package::CreateResourceResponseFromHeaderString(base::StrCat(
+            {"HTTP/1.1 ", base::NumberToString(static_cast<int>(status)), " ",
+             net::GetHttpReasonPhrase(status),
+             "\r\nContent-Type: text/plain\r\n\r\n"}));
+    head->content_length = 0;
+    ParseAndRespond(std::move(head), /*bundle_response=*/nullptr);
+  }
+
+  // Strips app headers, injects the Tier 0 policy, then has the network
+  // service parse the result (out of process; Rule of 2) so that navigations
+  // and worker scripts enforce exactly the injected policy.
+  void ParseAndRespond(network::mojom::URLResponseHeadPtr head,
+                       web_package::mojom::BundleResponsePtr bundle_response) {
+    SetRequiredHeadersForKeyWeb(*head->headers);
+    scoped_refptr<net::HttpResponseHeaders> headers = head->headers;
+    content::GetNetworkService()->ParseHeaders(
+        request_.url, std::move(headers),
+        base::BindOnce(&KeyWebURLLoader::OnHeadersParsed,
+                       weak_factory_.GetWeakPtr(), std::move(head),
+                       std::move(bundle_response)));
+  }
+
+  void OnHeadersParsed(network::mojom::URLResponseHeadPtr head,
+                       web_package::mojom::BundleResponsePtr bundle_response,
+                       network::mojom::ParsedHeadersPtr parsed_headers) {
+    if (!client_.is_connected()) {
+      return;
+    }
+    head->parsed_headers = std::move(parsed_headers);
+
+    const bool has_body = bundle_response && bundle_response->payload_length &&
+                          request_.method != net::HttpRequestHeaders::kHeadMethod;
+    body_length_ = has_body ? bundle_response->payload_length : 0;
+
+    mojo::ScopedDataPipeProducerHandle producer;
+    mojo::ScopedDataPipeConsumerHandle consumer;
+    MojoCreateDataPipeOptions options;
+    options.struct_size = sizeof(MojoCreateDataPipeOptions);
+    options.flags = MOJO_CREATE_DATA_PIPE_FLAG_NONE;
+    options.element_num_bytes = 1;
+    options.capacity_num_bytes = static_cast<uint32_t>(std::max<uint64_t>(
+        1, std::min<uint64_t>(network::GetDataPipeDefaultAllocationSize(),
+                              body_length_)));
+    if (mojo::CreateDataPipe(&options, producer, consumer) != MOJO_RESULT_OK) {
+      Fail(net::ERR_INSUFFICIENT_RESOURCES, "key-web: out of data pipes.");
+      return;
+    }
+    client_->OnReceiveResponse(std::move(head), std::move(consumer),
+                               std::nullopt);
+
+    if (!has_body) {
+      producer.reset();
+      Complete(net::OK);
+      return;
+    }
+    if (!reader_) {
+      Complete(net::ERR_FAILED);
+      return;
+    }
+    reader_->ReadResponseBody(
+        std::move(bundle_response), std::move(producer),
+        base::BindOnce(&KeyWebURLLoader::Complete,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void Complete(net::Error error) {
+    if (!client_.is_connected()) {
+      return;
+    }
+    network::URLLoaderCompletionStatus status(error);
+    status.encoded_data_length = static_cast<int64_t>(body_length_);
+    status.encoded_body_length = static_cast<int64_t>(body_length_);
+    status.decoded_body_length = static_cast<int64_t>(body_length_);
+    client_->OnComplete(status);
+  }
+
+  void Fail(net::Error error, const std::string& message) {
+    LogToConsole(frame_tree_node_id_, message);
+    if (client_.is_connected()) {
+      client_->OnComplete(network::URLLoaderCompletionStatus(error));
+    }
+  }
+
+  // network::mojom::URLLoader:
+  void FollowRedirect(
+      network::HttpRequestHeadersUpdateParams headers_update_params,
+      const std::optional<GURL>& new_url) override {
+    // This loader never issues redirects.
+  }
+  void SetPriority(net::RequestPriority priority,
+                   int intra_priority_value) override {}
+
+  base::WeakPtr<KeyWebReaderCache> cache_;
+  const KeyWebOrigin origin_;
+  mojo::Remote<network::mojom::URLLoaderClient> client_;
+  const network::ResourceRequest request_;
+  const std::optional<content::FrameTreeNodeId> frame_tree_node_id_;
+  base::WeakPtr<web_app::SignedWebBundleReader> reader_;
+  uint64_t body_length_ = 0;
+  base::WeakPtrFactory<KeyWebURLLoader> weak_factory_{this};
+};
+
+class KeyWebURLLoaderFactoryImpl : public network::SelfDeletingURLLoaderFactory {
+ public:
+  KeyWebURLLoaderFactoryImpl(
+      base::WeakPtr<KeyWebReaderCache> cache,
+      std::optional<url::Origin> app_origin,
+      std::optional<content::FrameTreeNodeId> frame_tree_node_id,
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+      base::SelfDeletingPassKey key)
+      : network::SelfDeletingURLLoaderFactory(std::move(receiver), key),
+        cache_(std::move(cache)),
+        app_origin_(std::move(app_origin)),
+        frame_tree_node_id_(frame_tree_node_id) {
+    CHECK(!app_origin_ || app_origin_->scheme() == kKeyWebScheme);
+  }
+
+  KeyWebURLLoaderFactoryImpl(const KeyWebURLLoaderFactoryImpl&) = delete;
+  KeyWebURLLoaderFactoryImpl& operator=(const KeyWebURLLoaderFactoryImpl&) =
+      delete;
+
+ private:
+  ~KeyWebURLLoaderFactoryImpl() override = default;
+
+  // network::mojom::URLLoaderFactory:
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader_receiver,
+      int32_t request_id,
+      uint32_t options,
+      const network::ResourceRequest& request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& traffic_annotation)
+      override {
+    DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+    if (!request.url.SchemeIs(kKeyWebScheme)) {
+      ReportBadMessage("key-web factory got a non key-web URL");
+      return;
+    }
+
+    auto fail = [&](net::Error error, const std::string& message) {
+      LogToConsole(frame_tree_node_id_, message);
+      mojo::Remote<network::mojom::URLLoaderClient>(std::move(client))
+          ->OnComplete(network::URLLoaderCompletionStatus(error));
+    };
+
+    // Only <kw-id>.key hosts are origins. Name hosts must have been resolved
+    // and bare IDs rewritten before reaching a loader.
+    base::expected<KeyWebOrigin, std::string> origin =
+        KeyWebOrigin::Create(request.url);
+    if (!origin.has_value()) {
+      fail(net::ERR_INVALID_URL, origin.error());
+      return;
+    }
+    if (app_origin_ && !app_origin_->IsSameOriginWith(origin->origin())) {
+      fail(net::ERR_BLOCKED_BY_CLIENT,
+           "key-web: cross-key subresource and worker loads are refused.");
+      return;
+    }
+    if (request.method != net::HttpRequestHeaders::kGetMethod &&
+        request.method != net::HttpRequestHeaders::kHeadMethod) {
+      fail(net::ERR_METHOD_NOT_SUPPORTED,
+           "key-web: only GET and HEAD are served from bundles.");
+      return;
+    }
+
+    auto loader = std::make_unique<KeyWebURLLoader>(
+        cache_, std::move(origin.value()), std::move(client), request,
+        frame_tree_node_id_);
+    KeyWebURLLoader* raw_loader = loader.get();
+    mojo::MakeSelfOwnedReceiver(std::move(loader), std::move(loader_receiver));
+    raw_loader->Start();
+  }
+
+  const base::WeakPtr<KeyWebReaderCache> cache_;
+  const std::optional<url::Origin> app_origin_;
+  const std::optional<content::FrameTreeNodeId> frame_tree_node_id_;
+};
+
+}  // namespace
+
+// static
+mojo::PendingRemote<network::mojom::URLLoaderFactory>
+KeyWebURLLoaderFactory::Create(
+    content::BrowserContext* browser_context,
+    std::optional<url::Origin> app_origin,
+    std::optional<content::FrameTreeNodeId> frame_tree_node_id) {
+  CHECK(browser_context);
+  mojo::PendingRemote<network::mojom::URLLoaderFactory> remote;
+  base::MakeSelfDeleting<KeyWebURLLoaderFactoryImpl>(
+      KeyWebReaderCache::GetOrCreate(browser_context).GetWeakPtr(),
+      std::move(app_origin), frame_tree_node_id,
+      remote.InitWithNewPipeAndPassReceiver());
+  return remote;
+}
+
+}  // namespace key_web
