@@ -0,0 +1,80 @@
+// Copyright 2026 The Key-Origin Web Authors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include <optional>
+#include <vector>
+
+#include "components/cbor/values.h"
+#include "components/cbor/writer.h"
+#include "components/webapps/key_web/url_loading/key_web_bundle_validation.h"
+#include "components/webapps/key_web/url_loading/key_web_url_rewrite.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace key_web {
+namespace {
+
+constexpr char kKEdId[] =
+    "mix2p32okr3zpmwz3pily6bmbjlfrjvpyzljdkc4mzvpkb6lf2mqaaic";
+
+std::vector<uint8_t> Attributes(std::optional<cbor::Value> key_web) {
+  cbor::Value::MapValue map;
+  map.emplace(cbor::Value("webBundleId"), cbor::Value(kKEdId));
+  if (key_web) {
+    map.emplace(cbor::Value("keyWeb"), std::move(*key_web));
+  }
+  return *cbor::Writer::Write(cbor::Value(std::move(map)));
+}
+
+cbor::Value KeyWeb(int version, std::optional<int> seq) {
+  cbor::Value::MapValue kw;
+  kw.emplace(cbor::Value("v"), cbor::Value(version));
+  if (seq) {
+    kw.emplace(cbor::Value("seq"), cbor::Value(*seq));
+  }
+  kw.emplace(cbor::Value("prev"), cbor::Value());  // null
+  return cbor::Value(std::move(kw));
+}
+
+TEST(KeyWebBundleValidationTest, AcceptsKeyWebAttribute) {
+  auto attribute = ParseKeyWebAttribute(Attributes(KeyWeb(1, 7)));
+  ASSERT_TRUE(attribute.has_value()) << attribute.error();
+  EXPECT_EQ(attribute->version, 1u);
+  EXPECT_EQ(attribute->seq, 7u);
+}
+
+TEST(KeyWebBundleValidationTest, RejectsBundleWithoutKeyWebAttr) {
+  // A plain Isolated Web App bundle: its author never targeted key-web.
+  EXPECT_FALSE(ParseKeyWebAttribute(Attributes(std::nullopt)).has_value());
+}
+
+TEST(KeyWebBundleValidationTest, RejectsMalformedKeyWebAttr) {
+  EXPECT_FALSE(ParseKeyWebAttribute(Attributes(KeyWeb(2, 1))).has_value());
+  EXPECT_FALSE(
+      ParseKeyWebAttribute(Attributes(KeyWeb(1, std::nullopt))).has_value());
+  EXPECT_FALSE(
+      ParseKeyWebAttribute(Attributes(cbor::Value("yes"))).has_value());
+  const std::vector<uint8_t> garbage = {0xff, 0x00, 0x13};
+  EXPECT_FALSE(ParseKeyWebAttribute(garbage).has_value());
+}
+
+TEST(KeyWebUrlRewriteTest, BareIdBecomesKeyHost) {
+  GURL url(std::string("key-web://") + kKEdId + "/notes?x=1#y");
+  ASSERT_TRUE(RewriteBareKeyWebUrl(&url, nullptr));
+  EXPECT_EQ(url, GURL(std::string("key-web://") + kKEdId + ".key/notes?x=1#y"));
+}
+
+TEST(KeyWebUrlRewriteTest, LeavesEverythingElseAlone) {
+  for (const char* spec :
+       {"key-web://cool-site.alice.example/", "https://example.org/",
+        "key-web://not-a-key/"}) {
+    GURL url(spec);
+    EXPECT_FALSE(RewriteBareKeyWebUrl(&url, nullptr)) << spec;
+    EXPECT_EQ(url, GURL(spec));
+  }
+  GURL canonical(std::string("key-web://") + kKEdId + ".key/");
+  EXPECT_FALSE(RewriteBareKeyWebUrl(&canonical, nullptr));
+}
+
+}  // namespace
+}  // namespace key_web
