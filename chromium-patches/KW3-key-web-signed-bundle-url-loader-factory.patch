+
+assert(is_chromeos || is_win || is_mac || is_linux)
+
+# Non-network loader for key-web://<kw-id>.key/, backed by verified Signed
+# Web Bundles. Reuses SignedWebBundleReader (isolated_web_apps/reading) for
+# parsing and signature verification, and nothing else from Isolated Web Apps.
+source_set("url_loading") {
+  sources = [
+    "key_web_bundle_validation.cc",
+    "key_web_bundle_validation.h",
+    "key_web_reader_cache.cc",
+    "key_web_reader_cache.h",
+    "key_web_url_loader_factory.cc",
+    "key_web_url_loader_factory.h",
+    "key_web_url_rewrite.cc",
+    "key_web_url_rewrite.h",
+  ]
+  deps = [
+    "//base",
+    "//components/cbor",
+    "//components/web_package",
+    "//components/web_package/mojom",
+    "//components/webapps/isolated_web_apps",
+    "//components/webapps/key_web:origin",
+    "//components/webapps/key_web:scheme",
+    "//components/webapps/key_web/policy",
+    "//content/public/browser",
+    "//mojo/public/cpp/bindings",
+    "//mojo/public/cpp/system",
+    "//net",
+    "//services/network/public/cpp",
+    "//services/network/public/mojom",
+    "//third_party/blink/public/common:headers",
