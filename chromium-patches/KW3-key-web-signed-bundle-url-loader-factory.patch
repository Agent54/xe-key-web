new file mode 100644
--- /dev/null
+++ b/components/webapps/key_web/url_loading/key_web_bundle_validation.h
@@ -0,0 +1,53 @@
+// Copyright 2026 The Key-Origin Web Authors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#ifndef COMPONENTS_WEBAPPS_KEY_WEB_URL_LOADING_KEY_WEB_BUNDLE_VALIDATION_H_
+#define COMPONENTS_WEBAPPS_KEY_WEB_URL_LOADING_KEY_WEB_BUNDLE_VALIDATION_H_
+
+#include <cstdint>
+#include <string>
+
+#include "base/containers/span.h"
+#include "base/types/expected.h"
+
+namespace web_package {
+class SignedWebBundleIntegrityBlock;
+}  // namespace web_package
+
+namespace key_web {
+
+class KeyWebOrigin;
+
+// The parts of the `keyWeb` integrity-block attribute this prototype checks
+// (Spec §1.5). Full KEL / HWM handling lands with the release store.
+struct KeyWebAttribute {
+  uint64_t version = 0;
+  uint64_t seq = 0;
+};
+
+// Parses the integrity block's attributes map and returns its `keyWeb` entry.
+// Fails if the attribute is missing (author-intent binding: an IWA bundle that
+// never opted into key-web is never loaded as key-web), malformed, or of an
+// unsupported version.
+//
+// NOTE: this decodes signed-but-untrusted CBOR in the browser process with
+// //components/cbor and a small nesting limit. The production design moves it
+// into the memory-safe Rust integrity-block parser (Blueprint KW2, item 1).
+base::expected<KeyWebAttribute, std::string> ParseKeyWebAttribute(
+    base::span<const uint8_t> attributes_cbor);
+
+// Runs every key-web acceptance check that does not need persistent state, on
+// an integrity block whose signatures SignedWebBundleReader already verified:
+//   1. webBundleId == the origin's kw-id;
+//   2. self-certifying identity: some VERIFIED signature's public key derives
+//      to that kw-id. This is checked here, independently of the process-wide
+//      web_package::IdentityValidator, so Isolated Web App key-rotation data
+//      (vendor-distributed trust) can never vouch for a key-web origin;
+//   3. the `keyWeb` attribute is present and well-formed.
+base::expected<KeyWebAttribute, std::string> ValidateKeyWebIntegrityBlock(
+    const web_package::SignedWebBundleIntegrityBlock& integrity_block,
+    const KeyWebOrigin& origin);
+
+}  // namespace key_web
+
+#endif  // COMPONENTS_WEBAPPS_KEY_WEB_URL_LOADING_KEY_WEB_BUNDLE_VALIDATION_H_
diff --git a/components/webapps/key_web/url_loading/key_web_reader_cache.cc b/components/webapps/key_web/url_loading/key_web_reader_cache.cc
new file mode 100644
--- /dev/null
+++ b/components/webapps/key_web/url_loading/key_web_reader_cache.cc
@@ -0,0 +1,178 @@
+// Copyright 2026 The Key-Origin Web Authors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "components/webapps/key_web/url_loading/key_web_reader_cache.h"
+
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/strings/strcat.h"
+#include "base/task/thread_pool.h"
+#include "components/webapps/key_web/url_loading/key_web_bundle_validation.h"
+#include "content/public/browser/browser_context.h"
+#include "url/origin.h"
+
+namespace key_web {
+
+namespace {
+
+const char kUserDataKey[] = "key_web::KeyWebReaderCache";
+
+std::optional<base::File::Info> GetInfoBlocking(const base::FilePath& path) {
+  base::File::Info info;
+  if (!base::GetFileInfo(path, &info) || info.is_directory) {
+    return std::nullopt;
+  }
+  return info;
+}
+
+bool SameFile(const base::File::Info& a, const base::File::Info& b) {
+  return a.size == b.size && a.last_modified == b.last_modified;
+}
+
+}  // namespace
+
+KeyWebReaderCache::Entry::Entry() = default;
+KeyWebReaderCache::Entry::Entry(Entry&&) = default;
+KeyWebReaderCache::Entry& KeyWebReaderCache::Entry::operator=(Entry&&) =
+    default;
+KeyWebReaderCache::Entry::~Entry() = default;
+
+// static
+KeyWebReaderCache& KeyWebReaderCache::GetOrCreate(
+    content::BrowserContext* context) {
+  auto* cache = static_cast<KeyWebReaderCache*>(context->GetUserData(
+      kUserDataKey));
+  if (!cache) {
+    auto owned = std::make_unique<KeyWebReaderCache>(
+        GetBundleDirectory(context));
+    cache = owned.get();
+    context->SetUserData(kUserDataKey, std::move(owned));
+  }
+  return *cache;
+}
+
+// static
+base::FilePath KeyWebReaderCache::GetBundleDirectory(
+    content::BrowserContext* context) {
+  return context->GetPath().Append(FILE_PATH_LITERAL("Key Web Bundles"));
+}
+
+KeyWebReaderCache::KeyWebReaderCache(base::FilePath bundle_directory)
+    : bundle_directory_(std::move(bundle_directory)) {}
+
+KeyWebReaderCache::~KeyWebReaderCache() = default;
+
+void KeyWebReaderCache::GetVerifiedReader(const KeyWebOrigin& origin,
+                                          ReaderCallback callback) {
+  // The file name is derived from the already-validated kw-id (base32 only),
+  // never from the request path, so it cannot escape the bundle directory.
+  const base::FilePath path = bundle_directory_.AppendASCII(
+      base::StrCat({origin.web_bundle_id().id(), ".swbn"}));
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(&GetInfoBlocking, path),
+      base::BindOnce(&KeyWebReaderCache::OnFileInfo,
+                     weak_factory_.GetWeakPtr(), origin, path,
+                     std::move(callback)));
+}
+
+void KeyWebReaderCache::OnFileInfo(const KeyWebOrigin& origin,
+                                   const base::FilePath& path,
+                                   ReaderCallback callback,
+                                   std::optional<base::File::Info> info) {
+  const std::string& id = origin.web_bundle_id().id();
+  if (!info) {
+    entries_.erase(id);
+    std::move(callback).Run(base::unexpected(base::StrCat(
+        {"No release of key-web://", id,
+         ".key/ is available on this device yet."})));
+    return;
+  }
+
+  auto it = entries_.find(id);
+  if (it != entries_.end() && SameFile(it->second.file_info, *info)) {
+    if (it->second.reader) {
+      std::move(callback).Run(it->second.reader->AsWeakPtr());
+      return;
+    }
+    // Verification of this exact file is already in flight.
+    it->second.pending.push_back(std::move(callback));
+    return;
+  }
+
+  // New or changed file: (re)verify from scratch. Callers waiting on an older
+  // file version are failed rather than silently handed the new one.
+  if (it != entries_.end()) {
+    Resolve(id, base::unexpected("The release changed while loading."));
+    entries_.erase(it);
+  }
+  Entry& entry = entries_[id];
+  entry.file_info = *info;
+  entry.generation = ++next_generation_;
+  entry.pending.push_back(std::move(callback));
+
+  web_app::SignedWebBundleReader::Create(
+      path, origin.GetUrl(), /*verify_signatures=*/true,
+      base::BindOnce(&KeyWebReaderCache::OnReaderCreated,
+                     weak_factory_.GetWeakPtr(), origin, entry.generation));
+}
+
+void KeyWebReaderCache::OnReaderCreated(
+    const KeyWebOrigin& origin,
+    uint64_t generation,
+    web_app::SignedWebBundleReader::Result result) {
+  const std::string& id = origin.web_bundle_id().id();
+  auto it = entries_.find(id);
+  if (it == entries_.end() || it->second.generation != generation) {
+    return;  // Superseded by a newer file; never adopt a stale verification.
+  }
+  if (!result.has_value()) {
+    Resolve(id, base::unexpected(base::StrCat(
+                    {"Invalid key-web bundle: ", result.error().message()})));
+    entries_.erase(id);
+    return;
+  }
+
+  std::unique_ptr<web_app::SignedWebBundleReader> reader =
+      std::move(result.value());
+
+  base::expected<KeyWebAttribute, std::string> attribute =
+      ValidateKeyWebIntegrityBlock(reader->GetIntegrityBlock(), origin);
+  if (!attribute.has_value()) {
+    Resolve(id, base::unexpected(attribute.error()));
+    entries_.erase(id);
+    return;
+  }
+
+  // Spec §1.5 step 7: every response must be same-origin with the key URL.
+  for (const GURL& entry_url : reader->GetEntries()) {
+    if (!origin.origin().IsSameOriginWith(entry_url)) {
+      Resolve(id, base::unexpected(base::StrCat(
+                      {"Bundle entry ", entry_url.possibly_invalid_spec(),
+                       " is not same-origin with key-web://", id, ".key"})));
+      entries_.erase(id);
+      return;
+    }
+  }
+
+  Entry& entry = entries_[id];
+  entry.reader = std::move(reader);
+  Resolve(id, entry.reader->AsWeakPtr());
+}
+
+void KeyWebReaderCache::Resolve(const std::string& id,
+                                const ReaderOrError& result) {
+  auto it = entries_.find(id);
+  if (it == entries_.end()) {
+    return;
+  }
+  std::vector<ReaderCallback> pending = std::move(it->second.pending);
+  for (ReaderCallback& callback : pending) {
+    std::move(callback).Run(result);
+  }
+}
+
+}  // namespace key_web
