diff --git a/components/webapps/key_web/policy/header_policy.cc b/components/webapps/key_web/policy/header_policy.cc
new file mode 100644
--- /dev/null
+++ b/components/webapps/key_web/policy/header_policy.cc
@@ -0,0 +1,184 @@
+// Copyright 2026 The Key-Origin Web Authors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "components/webapps/key_web/policy/header_policy.h"
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "net/http/http_response_headers.h"
+
+namespace key_web {
+
+namespace {
+
+// Spec §2.3. The first four directives are the exfiltration-proof core; the
+// remainder only constrain local resource kinds and add no network source.
+inline constexpr char kKeyWebCsp[] =
+    "default-src 'self';"
+    "connect-src 'none';"
+    "img-src 'self' data: blob:;"
+    "form-action 'none';"
+    "script-src 'self' 'wasm-unsafe-eval';"
+    "style-src 'self' 'unsafe-inline';"
+    "media-src 'self' data: blob:;"
+    "font-src 'self' data: blob:;"
+    "worker-src 'self' blob:;"
+    "frame-src 'self' blob:;"
+    "fenced-frame-src 'none';"
+    "manifest-src 'self';"
+    "object-src 'none';"
+    "base-uri 'none';"
+    "frame-ancestors 'self';"
+    "require-trusted-types-for 'script';";
+
+// Spec §2.4. Report-only lists are never used: reporting is egress.
+inline constexpr char kKeyWebConnectionAllowlist[] =
+    "(response-origin);redirects=block;webrtc=block";
+
+// Spec §2.7, Tier 0. Everything that can reach a sensor, a radio, a
+// peripheral, a payment/credential ceremony or an ad API is denied.
+inline constexpr char kKeyWebPermissionsPolicy[] =
+    "accelerometer=(), ambient-light-sensor=(), attribution-reporting=(), "
+    "autoplay=(self), bluetooth=(), browsing-topics=(), camera=(), "
+    "clipboard-read=(), clipboard-write=(self), controlled-frame=(), "
+    "cross-origin-isolated=(self), direct-sockets=(), display-capture=(), "
+    "encrypted-media=(), fullscreen=(self), gamepad=(self), geolocation=(), "
+    "gyroscope=(), hid=(), identity-credentials-get=(), idle-detection=(), "
+    "join-ad-interest-group=(), keyboard-map=(self), local-fonts=(), "
+    "magnetometer=(), microphone=(), midi=(), otp-credentials=(), payment=(), "
+    "picture-in-picture=(self), private-state-token-issuance=(), "
+    "private-state-token-redemption=(), publickey-credentials-create=(), "
+    "publickey-credentials-get=(), run-ad-auction=(), screen-wake-lock=(self), "
+    "serial=(), shared-storage=(), shared-storage-select-url=(), "
+    "storage-access=(), usb=(), web-share=(), window-management=()";
+
+// Spec §2.6 (L5). App-supplied copies of these are always removed.
+inline constexpr const char* kStrippedHeaders[] = {
+    // Reporting is an egress channel.
+    "Report-To",
+    "Reporting-Endpoints",
+    "NEL",
+    "Content-Security-Policy-Report-Only",
+    "Cross-Origin-Embedder-Policy-Report-Only",
+    "Cross-Origin-Opener-Policy-Report-Only",
+    "Document-Policy-Report-Only",
+    // Only the UA sets the allowlist (a second list would also trip
+    // ConnectionAllowlistIssue::kMoreThanOneList).
+    "Connection-Allowlist",
+    "Connection-Allowlist-Report-Only",
+    "Allow-Connection-Allowlist-From",
+    // preconnect / dns-prefetch / preload / modulepreload hints.
+    "Link",
+    // Navigation and speculation vectors.
+    "Refresh",
+    "Speculation-Rules",
+    "Supports-Loading-Mode",
+    // Meaningless (or dangerous) for a non-network origin.
+    "Set-Cookie",
+    "Accept-CH",
+    "Critical-CH",
+    "Alt-Svc",
+    "Strict-Transport-Security",
+    "Clear-Site-Data",
+    // Replaced by UA values below.
+    "Permissions-Policy",
+    "Cross-Origin-Opener-Policy",
+    "Cross-Origin-Embedder-Policy",
+    "Cross-Origin-Resource-Policy",
+    "Referrer-Policy",
+    "Origin-Agent-Cluster",
+    "X-DNS-Prefetch-Control",
+    "X-Content-Type-Options",
+};
+
+bool IsReportingDirective(std::string_view directive) {
+  std::string_view trimmed =
+      base::TrimWhitespaceASCII(directive, base::TRIM_ALL);
+  size_t end = trimmed.find_first_of(" \t");
+  std::string_view name =
+      end == std::string_view::npos ? trimmed : trimmed.substr(0, end);
+  return base::EqualsCaseInsensitiveASCII(name, "report-uri") ||
+         base::EqualsCaseInsensitiveASCII(name, "report-to");
+}
+
+}  // namespace
+
+std::string_view GetKeyWebContentSecurityPolicy() {
+  return kKeyWebCsp;
+}
+
+std::string_view GetKeyWebConnectionAllowlist() {
+  return kKeyWebConnectionAllowlist;
+}
+
+std::string_view GetKeyWebPermissionsPolicy() {
+  return kKeyWebPermissionsPolicy;
+}
+
+std::string StripCspReportingDirectives(std::string_view csp_value) {
+  // A header value may carry several comma-separated policies, each a list of
+  // semicolon-separated directives. Only whole directives are dropped; the
+  // value is never otherwise interpreted here (the network service parses it).
+  std::vector<std::string> policies;
+  for (std::string_view policy :
+       base::SplitStringPiece(csp_value, ",", base::TRIM_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    std::vector<std::string_view> kept;
+    for (std::string_view directive :
+         base::SplitStringPiece(policy, ";", base::TRIM_WHITESPACE,
+                                base::SPLIT_WANT_NONEMPTY)) {
+      if (!IsReportingDirective(directive)) {
+        kept.push_back(directive);
+      }
+    }
+    if (!kept.empty()) {
+      policies.push_back(base::JoinString(kept, "; "));
+    }
+  }
+  return base::JoinString(policies, ", ");
+}
+
+void SanitizeKeyWebResponseHeaders(net::HttpResponseHeaders& headers) {
+  for (const char* name : kStrippedHeaders) {
+    headers.RemoveHeader(name);
+  }
+
+  std::vector<std::string> app_csps;
+  size_t iter = 0;
+  while (std::optional<std::string_view> value =
+             headers.EnumerateHeader(&iter, "Content-Security-Policy")) {
+    app_csps.emplace_back(StripCspReportingDirectives(*value));
+  }
+  headers.RemoveHeader("Content-Security-Policy");
+  for (const std::string& csp : app_csps) {
+    if (!csp.empty()) {
+      headers.AddHeader("Content-Security-Policy", csp);
+    }
+  }
+}
+
+void SetRequiredHeadersForKeyWeb(net::HttpResponseHeaders& headers) {
+  SanitizeKeyWebResponseHeaders(headers);
+
+  // Added next to the app's (now report-free) policies: both are enforced,
+  // so the app can only make things stricter.
+  headers.AddHeader("Content-Security-Policy", kKeyWebCsp);
+  headers.SetHeader("Connection-Allowlist", kKeyWebConnectionAllowlist);
+  headers.SetHeader("Cross-Origin-Opener-Policy", "same-origin");
+  headers.SetHeader("Cross-Origin-Embedder-Policy", "require-corp");
+  headers.SetHeader("Cross-Origin-Resource-Policy", "same-origin");
+  headers.SetHeader("Origin-Agent-Cluster", "?1");
+  headers.SetHeader("Referrer-Policy", "no-referrer");
+  // Irreversible per document; switches off Blink's <link rel=dns-prefetch>.
+  headers.SetHeader("X-DNS-Prefetch-Control", "off");
+  headers.SetHeader("X-Content-Type-Options", "nosniff");
+  headers.SetHeader("Permissions-Policy", kKeyWebPermissionsPolicy);
+  headers.SetHeader("Cache-Control", "no-store");
+}
+
+}  // namespace key_web
