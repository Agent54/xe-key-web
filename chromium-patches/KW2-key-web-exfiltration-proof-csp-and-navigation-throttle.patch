@@ -0,0 +1,198 @@
+// Copyright 2026 The Key-Origin Web Authors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "chrome/browser/key_web/key_web_navigation_throttle.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/feature_list.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/strings/strcat.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/ui/tab_modal_confirm_dialog.h"
+#include "chrome/browser/ui/tab_modal_confirm_dialog_delegate.h"
+#include "chrome/common/chrome_features.h"
+#include "content/public/browser/global_routing_id.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/navigation_throttle_registry.h"
+#include "content/public/browser/page_navigator.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/blink/public/mojom/devtools/console_message.mojom-shared.h"
+#include "ui/base/clipboard/scoped_clipboard_writer.h"
+#include "ui/base/mojom/dialog_button.mojom.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+
+namespace key_web {
+
+namespace {
+
+// TODO(key-web): move user-visible strings into generated_resources.grd.
+class OutboundLinkDialogDelegate : public TabModalConfirmDialogDelegate {
+ public:
+  OutboundLinkDialogDelegate(content::WebContents* web_contents, GURL url)
+      : TabModalConfirmDialogDelegate(web_contents), url_(std::move(url)) {}
+  ~OutboundLinkDialogDelegate() override = default;
+
+  std::u16string GetTitle() override { return u"Leave this key-web app?"; }
+
+  // NG4: the COMPLETE destination, never truncated or elided. Everything in it
+  // (path, query, fragment) is visible to whoever runs the destination.
+  std::u16string GetDialogMessage() override {
+    return base::StrCat(
+        {u"This app is asking to open the address below. Everything in it, "
+         u"including any text after \"?\" or \"#\", will be sent to that "
+         u"site.\n\n",
+         base::UTF8ToUTF16(url_.possibly_invalid_spec())});
+  }
+
+  std::u16string GetAcceptButtonTitle() override { return u"Open in new tab"; }
+  std::u16string GetCancelButtonTitle() override { return u"Cancel"; }
+  std::u16string GetLinkText() const override { return u"Copy address"; }
+
+  std::optional<int> GetDefaultDialogButton() override {
+    return static_cast<int>(ui::mojom::DialogButton::kCancel);
+  }
+  std::optional<int> GetInitiallyFocusedButton() override {
+    return static_cast<int>(ui::mojom::DialogButton::kCancel);
+  }
+
+ private:
+  void OnAccepted() override {
+    if (!web_contents()) {
+      return;
+    }
+    // NG5: browser-initiated, so there is no initiator origin, no opener and
+    // an empty referrer. The key-web document learns nothing about the result.
+    web_contents()->OpenURL(
+        content::OpenURLParams::CreateBrowserInitiated(
+            url_, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+            ui::PAGE_TRANSITION_LINK),
+        /*navigation_handle_callback=*/{});
+  }
+
+  void OnLinkClicked(ui::mojom::WindowOpenDisposition) override {
+    ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+        .WriteText(base::UTF8ToUTF16(url_.possibly_invalid_spec()));
+    Cancel();
+  }
+
+  const GURL url_;
+};
+
+void ShowOutboundLinkDialog(base::WeakPtr<content::WebContents> web_contents,
+                            const GURL& url) {
+  if (!web_contents || web_contents->IsBeingDestroyed()) {
+    return;
+  }
+  TabModalConfirmDialog::Create(
+      std::make_unique<OutboundLinkDialogDelegate>(web_contents.get(), url),
+      web_contents.get());
+}
+
+}  // namespace
+
+void OfferOutboundNavigation(content::WebContents* web_contents,
+                             const GURL& url) {
+  if (!web_contents) {
+    return;
+  }
+  // Never show UI re-entrantly from inside navigation or window-creation
+  // callbacks.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&ShowOutboundLinkDialog, web_contents->GetWeakPtr(), url));
+}
+
+// static
+void KeyWebNavigationThrottle::MaybeCreateAndAdd(
+    content::NavigationThrottleRegistry& registry) {
+  // With the feature off, no key-web document can exist (the loader factory
+  // is not registered), so there is nothing to police.
+  if (!base::FeatureList::IsEnabled(features::kKeyOriginWeb)) {
+    return;
+  }
+  registry.AddThrottle(std::make_unique<KeyWebNavigationThrottle>(registry));
+}
+
+KeyWebNavigationThrottle::KeyWebNavigationThrottle(
+    content::NavigationThrottleRegistry& registry)
+    : content::NavigationThrottle(registry) {}
+
+KeyWebNavigationThrottle::~KeyWebNavigationThrottle() = default;
+
+KeyWebNavigationThrottle::ThrottleCheckResult
+KeyWebNavigationThrottle::WillStartRequest() {
+  return Evaluate();
+}
+
+KeyWebNavigationThrottle::ThrottleCheckResult
+KeyWebNavigationThrottle::WillRedirectRequest() {
+  // The key-web loader never redirects except name/bare-ID -> key URL, which
+  // stays same-origin. Re-check anyway: a redirect must not launder egress.
+  return Evaluate();
+}
+
+const char* KeyWebNavigationThrottle::GetNameForLogging() {
+  return "KeyWebNavigationThrottle";
+}
+
+KeyWebNavigationThrottle::ThrottleCheckResult
+KeyWebNavigationThrottle::Evaluate() {
+  content::NavigationHandle* handle = navigation_handle();
+  NavigationFacts facts;
+  facts.initiator_origin = handle->GetInitiatorOrigin();
+  facts.url = handle->GetURL();
+  facts.is_main_frame = handle->IsInMainFrame();
+  facts.has_user_gesture = handle->HasUserGesture();
+  facts.is_speculative =
+      handle->IsInPrerenderedMainFrame() || handle->IsPrerenderedPageActivation();
+
+  switch (DecideKeyWebNavigation(facts)) {
+    case NavigationVerdict::kNotKeyWeb:
+    case NavigationVerdict::kAllowSameOrigin:
+    case NavigationVerdict::kAllowInert:
+      return PROCEED;
+    case NavigationVerdict::kCancelSpeculative:
+      return CANCEL;
+    case NavigationVerdict::kBlockSubframe:
+      LogToInitiator(base::StrCat(
+          {"key-web: blocked a cross-origin frame load of '",
+           facts.url.possibly_invalid_spec(),
+           "'. key-web apps have no network access in Tier 0."}));
+      return BLOCK_REQUEST;
+    case NavigationVerdict::kBlockNoUserGesture:
+      LogToInitiator(base::StrCat(
+          {"key-web: blocked a navigation to '",
+           facts.url.possibly_invalid_spec(),
+           "' that was not triggered by a user gesture."}));
+      return BLOCK_REQUEST;
+    case NavigationVerdict::kConfirmInNewContext:
+      OfferOutboundNavigation(handle->GetWebContents(), facts.url);
+      return CANCEL;
+  }
+}
+
+void KeyWebNavigationThrottle::LogToInitiator(const std::string& message) {
+  content::NavigationHandle* handle = navigation_handle();
+  const std::optional<blink::LocalFrameToken>& token =
+      handle->GetInitiatorFrameToken();
+  if (!token) {
+    return;
+  }
+  content::RenderFrameHost* initiator =
+      content::RenderFrameHost::FromFrameToken(
+          content::GlobalRenderFrameHostToken(handle->GetInitiatorProcessId(),
+                                              *token));
+  if (initiator) {
+    initiator->AddMessageToConsole(blink::mojom::ConsoleMessageLevel::kError,
+                                   message);
+  }
+}
+
+}  // namespace key_web
