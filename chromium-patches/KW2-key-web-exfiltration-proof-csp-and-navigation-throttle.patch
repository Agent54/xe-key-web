diff --git a/chrome/browser/key_web/key_web_navigation_policy.cc b/chrome/browser/key_web/key_web_navigation_policy.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/key_web/key_web_navigation_policy.cc
@@ -0,0 +1,46 @@
+// Copyright 2026 The Key-Origin Web Authors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "chrome/browser/key_web/key_web_navigation_policy.h"
+
+#include "components/webapps/key_web/scheme.h"
+#include "url/url_constants.h"
+
+namespace key_web {
+
+bool IsKeyWebOrigin(const url::Origin& origin) {
+  return !origin.opaque() && origin.scheme() == kKeyWebScheme;
+}
+
+NavigationVerdict DecideKeyWebNavigation(const NavigationFacts& facts) {
+  if (!facts.initiator_origin || !IsKeyWebOrigin(*facts.initiator_origin)) {
+    return NavigationVerdict::kNotKeyWeb;
+  }
+
+  // NG1. url::Origin::Create() resolves blob:key-web://<id>.key/<uuid> to the
+  // key-web origin, so same-origin blob: navigations land here too.
+  if (url::Origin::Create(facts.url).IsSameOriginWith(*facts.initiator_origin)) {
+    return NavigationVerdict::kAllowSameOrigin;
+  }
+
+  // Local documents that cannot carry data to the network.
+  if (facts.url.IsAboutBlank() || facts.url.IsAboutSrcdoc() ||
+      facts.url.SchemeIs(url::kDataScheme)) {
+    return NavigationVerdict::kAllowInert;
+  }
+
+  // Everything else is outbound (NG2): https:, other key-web keys, external
+  // protocols (mailto:, tel:, custom), filesystem:, cross-origin blob:, ...
+  if (facts.is_speculative) {
+    return NavigationVerdict::kCancelSpeculative;  // NG7
+  }
+  if (!facts.is_main_frame) {
+    return NavigationVerdict::kBlockSubframe;
+  }
+  if (!facts.has_user_gesture) {
+    return NavigationVerdict::kBlockNoUserGesture;  // NG4
+  }
+  return NavigationVerdict::kConfirmInNewContext;  // NG4 + NG5
+}
+
+}  // namespace key_web
diff --git a/chrome/browser/key_web/key_web_navigation_policy.h b/chrome/browser/key_web/key_web_navigation_policy.h
new file mode 100644
--- /dev/null
+++ b/chrome/browser/key_web/key_web_navigation_policy.h
@@ -0,0 +1,54 @@
+// Copyright 2026 The Key-Origin Web Authors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#ifndef CHROME_BROWSER_KEY_WEB_KEY_WEB_NAVIGATION_POLICY_H_
+#define CHROME_BROWSER_KEY_WEB_KEY_WEB_NAVIGATION_POLICY_H_
+
+#include <optional>
+
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace key_web {
+
+// The Navigation Gate (Spec §2.5, L3). Chromium 160 has no CSP `navigate-to`,
+// so outbound navigation from key-web documents is decided here, in the
+// browser process, from facts the renderer cannot forge.
+enum class NavigationVerdict {
+  // Not initiated by a key-web document: not our business.
+  kNotKeyWeb,
+  // NG1: same key-web origin (including blob: URLs whose inner origin matches).
+  kAllowSameOrigin,
+  // Local, network-free targets (about:blank, about:srcdoc, data:).
+  kAllowInert,
+  // NG7: prerender / speculative loads of outbound URLs never happen.
+  kCancelSpeculative,
+  // Ambient subframe egress (<iframe src=https://evil/?d=...>): always
+  // blocked. A subframe load can never be user-mediated.
+  kBlockSubframe,
+  // NG4: outbound top-level navigation without a user gesture (location=,
+  // meta refresh, timers, window.open without activation): blocked silently.
+  kBlockNoUserGesture,
+  // NG4/NG5: outbound top-level navigation WITH a user gesture: cancelled in
+  // place, then re-offered through a browser-owned prompt that shows the full
+  // URL and opens it in a new top-level context with no opener and no
+  // referrer, attributed to an opaque initiator.
+  kConfirmInNewContext,
+};
+
+struct NavigationFacts {
+  std::optional<url::Origin> initiator_origin;
+  GURL url;
+  bool is_main_frame = false;
+  bool has_user_gesture = false;
+  bool is_speculative = false;
+};
+
+NavigationVerdict DecideKeyWebNavigation(const NavigationFacts& facts);
+
+// True iff `origin` is a key-web:// origin.
+bool IsKeyWebOrigin(const url::Origin& origin);
+
+}  // namespace key_web
+
+#endif  // CHROME_BROWSER_KEY_WEB_KEY_WEB_NAVIGATION_POLICY_H_
diff --git a/chrome/browser/key_web/key_web_navigation_policy_unittest.cc b/chrome/browser/key_web/key_web_navigation_policy_unittest.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/key_web/key_web_navigation_policy_unittest.cc
@@ -0,0 +1,91 @@
+// Copyright 2026 The Key-Origin Web Authors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "chrome/browser/key_web/key_web_navigation_policy.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace key_web {
+namespace {
+
+constexpr char kAppA[] =
+    "key-web://mix2p32okr3zpmwz3pily6bmbjlfrjvpyzljdkc4mzvpkb6lf2mqaaic.key";
+
+NavigationFacts Facts(std::string_view url,
+                      bool main_frame = true,
+                      bool gesture = false,
+                      std::optional<std::string_view> initiator = kAppA) {
+  NavigationFacts facts;
+  if (initiator) {
+    facts.initiator_origin = url::Origin::Create(GURL(*initiator));
+  }
+  facts.url = GURL(url);
+  facts.is_main_frame = main_frame;
+  facts.has_user_gesture = gesture;
+  return facts;
+}
+
+TEST(KeyWebNavigationPolicyTest, NonKeyWebInitiatorIsIgnored) {
+  EXPECT_EQ(DecideKeyWebNavigation(
+                Facts("https://a.test/", true, false, "https://b.test")),
+            NavigationVerdict::kNotKeyWeb);
+  EXPECT_EQ(DecideKeyWebNavigation(
+                Facts("https://a.test/", true, false, std::nullopt)),
+            NavigationVerdict::kNotKeyWeb);
+}
+
+TEST(KeyWebNavigationPolicyTest, SameOriginFree) {
+  EXPECT_EQ(DecideKeyWebNavigation(Facts(std::string(kAppA) + "/next.html")),
+            NavigationVerdict::kAllowSameOrigin);
+  EXPECT_EQ(
+      DecideKeyWebNavigation(Facts(std::string("blob:") + kAppA + "/uuid")),
+      NavigationVerdict::kAllowSameOrigin);
+}
+
+TEST(KeyWebNavigationPolicyTest, InertTargetsAllowed) {
+  EXPECT_EQ(DecideKeyWebNavigation(Facts("about:blank", false)),
+            NavigationVerdict::kAllowInert);
+  EXPECT_EQ(DecideKeyWebNavigation(Facts("about:srcdoc", false)),
+            NavigationVerdict::kAllowInert);
+  EXPECT_EQ(DecideKeyWebNavigation(Facts("data:text/plain,x", false)),
+            NavigationVerdict::kAllowInert);
+}
+
+TEST(KeyWebNavigationPolicyTest, NoGestureBlocked) {
+  EXPECT_EQ(DecideKeyWebNavigation(Facts("https://evil.test/?d=secret")),
+            NavigationVerdict::kBlockNoUserGesture);
+  EXPECT_EQ(DecideKeyWebNavigation(Facts("mailto:x@evil.test?body=secret")),
+            NavigationVerdict::kBlockNoUserGesture);
+}
+
+TEST(KeyWebNavigationPolicyTest, SubframeEgressAlwaysBlocked) {
+  EXPECT_EQ(DecideKeyWebNavigation(
+                Facts("https://evil.test/?d=secret", false, /*gesture=*/true)),
+            NavigationVerdict::kBlockSubframe);
+}
+
+TEST(KeyWebNavigationPolicyTest, OtherKeyIsOutbound) {
+  EXPECT_EQ(DecideKeyWebNavigation(Facts(
+                "key-web://"
+                "aerugqztij5biqquuk3mfwpsaibuegaqcitgfchwuosuofdjabzqaaic.key/",
+                true, true)),
+            NavigationVerdict::kConfirmInNewContext);
+}
+
+TEST(KeyWebNavigationPolicyTest, GestureNeedsConfirmation) {
+  EXPECT_EQ(DecideKeyWebNavigation(
+                Facts("https://example.org/help", true, /*gesture=*/true)),
+            NavigationVerdict::kConfirmInNewContext);
+}
+
+TEST(KeyWebNavigationPolicyTest, SpeculationRulesIgnored) {
+  NavigationFacts facts = Facts("https://evil.test/", true, true);
+  facts.is_speculative = true;
+  EXPECT_EQ(DecideKeyWebNavigation(facts),
+            NavigationVerdict::kCancelSpeculative);
+}
+
+}  // namespace
+}  // namespace key_web
