new file mode 100644
--- /dev/null
+++ b/components/webapps/key_web/policy/header_policy.h
@@ -0,0 +1,60 @@
+// Copyright 2026 The Key-Origin Web Authors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#ifndef COMPONENTS_WEBAPPS_KEY_WEB_POLICY_HEADER_POLICY_H_
+#define COMPONENTS_WEBAPPS_KEY_WEB_POLICY_HEADER_POLICY_H_
+
+#include <string>
+#include <string_view>
+
+namespace net {
+class HttpResponseHeaders;
+}  // namespace net
+
+namespace key_web {
+
+// The exfiltration-proof default Content-Security-Policy enforced on every
+// key-web response (documents, workers, service workers). It is ADDED next to
+// any policy the app ships, so an app can only tighten it.
+//
+// Core (no network source anywhere):
+//   default-src 'self'; connect-src 'none'; img-src 'self' data: blob:;
+//   form-action 'none'
+// plus hardening directives that never add a network source.
+//
+// There is deliberately no `navigate-to`: Chromium 160 does not implement it
+// (absent from network::mojom::CSPDirectiveName) and unknown directives are
+// ignored. Outbound navigation is enforced by KeyWebNavigationThrottle.
+std::string_view GetKeyWebContentSecurityPolicy();
+
+// `Connection-Allowlist: (response-origin);redirects=block;webrtc=block`.
+// response-origin resolves to key-web://<kw-id>.key, which is not a network
+// endpoint, so the effective network allowlist is empty. The network service
+// enforces it per document for DNS resolution, socket preconnect, prefetch,
+// WebTransport and WebRTC: exactly the paths CSP cannot see.
+std::string_view GetKeyWebConnectionAllowlist();
+
+// Tier 0 Permissions-Policy baseline (local presentation only).
+std::string_view GetKeyWebPermissionsPolicy();
+
+// Removes every app-supplied header that could open an egress channel,
+// loosen UA policy, or trigger a second Connection-Allowlist (L5). Also strips
+// `report-uri` / `report-to` directives from app-supplied CSP headers, since a
+// violation report is itself an egress.
+void SanitizeKeyWebResponseHeaders(net::HttpResponseHeaders& headers);
+
+// Sanitizes, then injects the UA policy: CSP (appended), Connection-Allowlist,
+// COOP/COEP/CORP, Origin-Agent-Cluster, Referrer-Policy, X-DNS-Prefetch-
+// Control: off, X-Content-Type-Options and Permissions-Policy.
+//
+// All injected values are compile-time constants, so re-parsing them in the
+// network service (as the IWA loader does) keeps the Rule of 2.
+void SetRequiredHeadersForKeyWeb(net::HttpResponseHeaders& headers);
+
+// Exposed for tests: removes report-uri/report-to directives from one
+// Content-Security-Policy header value (which may hold several policies).
+std::string StripCspReportingDirectives(std::string_view csp_value);
+
+}  // namespace key_web
+
+#endif  // COMPONENTS_WEBAPPS_KEY_WEB_POLICY_HEADER_POLICY_H_
