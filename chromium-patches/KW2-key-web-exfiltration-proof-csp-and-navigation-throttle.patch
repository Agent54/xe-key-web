@@ -0,0 +1,105 @@
+// Copyright 2026 The Key-Origin Web Authors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "components/webapps/key_web/policy/header_policy.h"
+
+#include <string>
+#include <vector>
+
+#include "base/memory/scoped_refptr.h"
+#include "net/http/http_response_headers.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace key_web {
+namespace {
+
+scoped_refptr<net::HttpResponseHeaders> MaliciousAppHeaders() {
+  return net::HttpResponseHeaders::TryToCreate(
+      "HTTP/1.1 200 OK\r\n"
+      "Content-Type: text/html\r\n"
+      "Content-Security-Policy: script-src 'self'; report-uri https://a.test/r\r\n"
+      "Content-Security-Policy-Report-Only: default-src 'none'; report-to x\r\n"
+      "Reporting-Endpoints: x=\"https://a.test/r\"\r\n"
+      "Report-To: {\"group\":\"x\"}\r\n"
+      "NEL: {\"report_to\":\"x\"}\r\n"
+      "Connection-Allowlist: (*)\r\n"
+      "Allow-Connection-Allowlist-From: *\r\n"
+      "Link: <https://a.test>; rel=preconnect\r\n"
+      "Refresh: 0;url=https://a.test/?d=secret\r\n"
+      "Speculation-Rules: \"/rules.json\"\r\n"
+      "Set-Cookie: a=b\r\n"
+      "Permissions-Policy: camera=*\r\n"
+      "Cross-Origin-Opener-Policy: unsafe-none\r\n"
+      "X-DNS-Prefetch-Control: on\r\n"
+      "\r\n");
+}
+
+std::vector<std::string> AllValues(const net::HttpResponseHeaders& headers,
+                                   std::string_view name) {
+  std::vector<std::string> out;
+  size_t iter = 0;
+  while (auto value = headers.EnumerateHeader(&iter, name)) {
+    out.emplace_back(*value);
+  }
+  return out;
+}
+
+TEST(KeyWebHeaderPolicyTest, CspHasNoNetworkSource) {
+  const std::string csp(GetKeyWebContentSecurityPolicy());
+  EXPECT_NE(csp.find("default-src 'self';"), std::string::npos);
+  EXPECT_NE(csp.find("connect-src 'none';"), std::string::npos);
+  EXPECT_NE(csp.find("img-src 'self' data: blob:;"), std::string::npos);
+  EXPECT_NE(csp.find("form-action 'none';"), std::string::npos);
+  for (const char* scheme : {"https:", "http:", "wss:", "ws:", "*"}) {
+    EXPECT_EQ(csp.find(scheme), std::string::npos) << scheme;
+  }
+  // navigate-to is not implemented in M160; relying on it is false assurance.
+  EXPECT_EQ(csp.find("navigate-to"), std::string::npos);
+  EXPECT_EQ(csp.find("report-"), std::string::npos);
+}
+
+TEST(KeyWebHeaderPolicyTest, AppHeadersCannotLoosen) {
+  auto headers = MaliciousAppHeaders();
+  SetRequiredHeadersForKeyWeb(*headers);
+
+  for (const char* stripped :
+       {"Content-Security-Policy-Report-Only", "Reporting-Endpoints",
+        "Report-To", "NEL", "Allow-Connection-Allowlist-From", "Link",
+        "Refresh", "Speculation-Rules", "Set-Cookie"}) {
+    EXPECT_FALSE(headers->HasHeader(stripped)) << stripped;
+  }
+  EXPECT_EQ(AllValues(*headers, "Connection-Allowlist"),
+            std::vector<std::string>{
+                std::string(GetKeyWebConnectionAllowlist())});
+  EXPECT_EQ(AllValues(*headers, "Cross-Origin-Opener-Policy"),
+            std::vector<std::string>{"same-origin"});
+  EXPECT_EQ(AllValues(*headers, "X-DNS-Prefetch-Control"),
+            std::vector<std::string>{"off"});
+  EXPECT_EQ(AllValues(*headers, "Permissions-Policy"),
+            std::vector<std::string>{
+                std::string(GetKeyWebPermissionsPolicy())});
+}
+
+TEST(KeyWebHeaderPolicyTest, CspReportUriStripped) {
+  auto headers = MaliciousAppHeaders();
+  SetRequiredHeadersForKeyWeb(*headers);
+  std::vector<std::string> csps =
+      AllValues(*headers, "Content-Security-Policy");
+  ASSERT_EQ(csps.size(), 2u);
+  EXPECT_EQ(csps[0], "script-src 'self'");  // the app's, minus reporting
+  EXPECT_EQ(csps[1], GetKeyWebContentSecurityPolicy());
+  for (const std::string& csp : csps) {
+    EXPECT_EQ(csp.find("report-"), std::string::npos) << csp;
+  }
+}
+
+TEST(KeyWebHeaderPolicyTest, StripCspReportingDirectives) {
+  EXPECT_EQ(StripCspReportingDirectives(
+                "default-src 'none'; REPORT-URI https://a.test, "
+                "img-src 'self'; report-to g"),
+            "default-src 'none', img-src 'self'");
+  EXPECT_EQ(StripCspReportingDirectives("report-uri /x"), "");
+}
