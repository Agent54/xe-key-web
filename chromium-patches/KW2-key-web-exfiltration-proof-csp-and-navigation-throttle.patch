+// Copyright 2026 The Key-Origin Web Authors
+// SPDX-License-Identifier: BSD-3-Clause
+
+#ifndef CHROME_BROWSER_KEY_WEB_KEY_WEB_NAVIGATION_THROTTLE_H_
+#define CHROME_BROWSER_KEY_WEB_KEY_WEB_NAVIGATION_THROTTLE_H_
+
+#include "chrome/browser/key_web/key_web_navigation_policy.h"
+#include "content/public/browser/navigation_throttle.h"
+#include "url/gurl.h"
+
+namespace content {
+class NavigationThrottleRegistry;
+class WebContents;
+}  // namespace content
+
+namespace key_web {
+
+// Polices every navigation initiated by a key-web:// document (Spec §2.5).
+//
+//   * same key-web origin                      -> PROCEED           (NG1)
+//   * about:blank / about:srcdoc / data:       -> PROCEED           (inert)
+//   * prerender / speculative                  -> CANCEL            (NG7)
+//   * cross-origin subframe                    -> BLOCK_REQUEST     (ambient)
+//   * cross-origin top level, no user gesture  -> BLOCK_REQUEST     (NG4)
+//   * cross-origin top level, user gesture     -> CANCEL in place, then a
+//     browser-owned prompt shows the FULL URL; "Open" loads it in a new
+//     foreground tab as a browser-initiated navigation: no opener, no
+//     referrer, no key-web initiator                         (NG4 + NG5)
+//
+// The same decision runs again on every redirect. Requests are cancelled
+// before any byte leaves the browser, so a blocked URL is never resolved,
+// connected to, or fetched.
+class KeyWebNavigationThrottle : public content::NavigationThrottle {
+ public:
+  static void MaybeCreateAndAdd(content::NavigationThrottleRegistry& registry);
+
+  explicit KeyWebNavigationThrottle(
+      content::NavigationThrottleRegistry& registry);
+  KeyWebNavigationThrottle(const KeyWebNavigationThrottle&) = delete;
+  KeyWebNavigationThrottle& operator=(const KeyWebNavigationThrottle&) =
+      delete;
+  ~KeyWebNavigationThrottle() override;
+
+  // content::NavigationThrottle:
+  ThrottleCheckResult WillStartRequest() override;
+  ThrottleCheckResult WillRedirectRequest() override;
+  const char* GetNameForLogging() override;
+
+ private:
+  ThrottleCheckResult Evaluate();
+  void LogToInitiator(const std::string& message);
+};
+
+// Shows the browser-owned outbound-link prompt (full URL; Open / Copy /
+// Cancel) over `web_contents`. Used by the throttle and by
+// ChromeContentBrowserClient::CanCreateWindow() for key-web openers.
+void OfferOutboundNavigation(content::WebContents* web_contents,
+                             const GURL& url);
+
+}  // namespace key_web
+
+#endif  // CHROME_BROWSER_KEY_WEB_KEY_WEB_NAVIGATION_THROTTLE_H_
