  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0d0f13",
  "theme_color": "#15181f",
  "icons": [
    { "src": "/icon-256.png", "sizes": "256x256", "type": "image/png", "purpose": "any" }
  ]
}
